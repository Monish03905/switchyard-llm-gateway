# Copy to .env and fill only what you need. `.env` is gitignored.
# Every value below is read by app/config.py (upper or lower case both work).
# With no provider keys, the yard runs in a deterministic simulator instead of
# blocking startup. That is deliberate: the demo, the tests, and the CI gate all
# work before you spend a cent.

APP_ENV=development
APP_VERSION=1.0.0
LOG_LEVEL=INFO
SERVE_FRONTEND=true
CORS_ORIGINS=*

# --- storage -------------------------------------------------------------
# SQLite is the zero-setup default; Postgres is drop-in for production.
DATABASE_URL=sqlite+aiosqlite:///./switchyard.db
# DATABASE_URL=postgresql+asyncpg://switchyard:switchyard@localhost:5432/switchyard
REDIS_URL=
# REDIS_URL=redis://localhost:6379/0

# --- providers -----------------------------------------------------------
# auto   = go live when a key exists, otherwise simulate
# live   = require a key (falls back to simulator if none is found)
# simulated = always rehearse, never call out
PROVIDER_MODE=auto
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL_CHEAP=llama-3.1-8b-instant
GROQ_MODEL_STRONG=llama-3.3-70b-versatile
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL_CHEAP=gpt-4o-mini
OPENAI_MODEL_STRONG=gpt-4o
# Name of the provider that should be tried last ("groq" / "openai").
FALLBACK_PROVIDER=

# --- reliability ---------------------------------------------------------
REQUEST_TIMEOUT_S=45
MAX_RETRIES=2
RETRY_BASE_MS=350
BREAKER_THRESHOLD=3
BREAKER_WINDOW_S=60
BREAKER_COOLDOWN_S=20
CACHE_TTL_S=3600
CACHE_MAX_ENTRIES=2000

# --- money & carbon ------------------------------------------------------
DAILY_BUDGET_USD=5
CARBON_INTENSITY_G_PER_KWH=380
DATACENTER_PUE=1.15

# --- access --------------------------------------------------------------
# Optional shared key for POST /v1/chat. Leave empty for an open demo.
GATEWAY_API_KEY=
# Required for /api/admin/* actions. Leave empty to disable admin actions.
ADMIN_TOKEN=
RATE_LIMIT_RPM=120
# Off by default: prompts stay out of the database unless you opt in.
STORE_PROMPTS=false
# Signs the tamper-evident ledger. Rotate it and old receipts stop verifying.
# Generate one: python -c "import secrets; print(secrets.token_urlsafe(48))"
LEDGER_KEY=

# --- simulator -----------------------------------------------------------
SIMULATOR_LATENCY_MIN_MS=70
SIMULATOR_LATENCY_MAX_MS=240
